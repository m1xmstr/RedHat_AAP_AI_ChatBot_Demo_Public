---
# Copy into a private inventory next to your hosts.yml as group_vars/all.yml.
aap_controller_url: "https://aap.example.org"
openshift_api_url: "https://api.cluster.example.org:6443"
aap_org_name: "Default"
aap_project_name: "EDU_AI_DEMO"
aap_project_scm_url: "https://github.com/m1xmstr/RedHat_AAP_AI_ChatBot_Demo_Public.git"
aap_project_scm_branch: "main"
aap_inventory_name: "EDU AI Demo Inventory"
aap_job_template_name: "EDU_AI_DEMO"
aap_validation_job_template_name: "EDU_AI_DEMO_VALIDATE"
aap_openshift_credential_name: "OpenShift API (EDU AI Demo)"
aap_scm_credential_name: ""
aap_machine_credential_name: ""
aap_execution_environment_name: ""
# With a configured endpoint, use the shared model for two-input launches.
demo_runtime: "openshift_ai"
demo_max_pages: 64
demo_openshift_ai_endpoint: ""  # Full URL of the deployed chat completions endpoint
demo_openshift_ai_model: ""  # Exact model ID served by that endpoint
demo_rhel_ai_app_host: "openshift"
demo_rhel_ai_endpoint: ""
demo_rhel_ai_model: ""
# Enable after the Virtualization admin creates the VM pool and verifies boot source, storage and image access.
demo_rhel_vm_enabled: false
demo_rhel_vm_namespace: edu-ai-demo-rhel-vms
demo_rhel_vm_source_namespace: openshift-virtualization-os-images
demo_rhel_vm_source_name: rhel9
demo_rhel_vm_storage_class: ocs-storagecluster-ceph-rbd-virtualization
# Optional Kubernetes hostname to keep the CPU inference guest on a chosen worker.
demo_rhel_vm_node: ""
demo_rhel_vm_cpu_cores: 4
demo_rhel_vm_cpu_request: "1500m"
